        }
        lines {
          text: "    domain: \'Product\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    originalPurpose: \'Single large catalog record storing item details, manufacturer brand attributes, and category classification in one place.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    originalColumns: [\'ProductID\', \'ProductName\', \'SKU\', \'Price\', \'Cost\', \'CategoryID\', \'CategoryName\', \'BrandID\', \'BrandName\', \'BrandCountry\'],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    anomalies: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Severe Transitive Dependency: ProductID -> CategoryID -> CategoryName.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Severe Transitive Dependency: ProductID -> BrandID -> BrandName, BrandCountry.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Update anomaly: Changing a brand name required updating thousands of product records.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Deletion anomaly: Deleting the last product of a brand deleted the brand entirely.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    nf1Explanation: \'Ensured atomic price, cost, SKU, and product name attributes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    nf2Explanation: \'ProductID is a single primary key; all non-key attributes fully depend on ProductID.\',"
