        lines {
          text: "    const handleKeyDown = (e: KeyboardEvent) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (e.key === \'ArrowRight\' || e.key === \' \') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        setCurrentSlide(prev => Math.min(slides.length - 1, prev + 1));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      } else if (e.key === \'ArrowLeft\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        setCurrentSlide(prev => Math.max(0, prev - 1));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      } else if (e.key === \'Escape\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
