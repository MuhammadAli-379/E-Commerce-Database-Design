cialID: 4, OrderID: 104, Subtotal: 249.99, TaxAmount: 12.50, ShippingFee: 10.00, TotalAmount: 272.49 },\n  ],\n  \'Order Items\': [\n    { OrderItemID: 1, OrderID: 101, ProductID: 1, Quantity: 1, UnitPrice: 1299.99 },\n    { OrderItemID: 2, OrderID: 102, ProductID: 3, Quantity: 1, UnitPrice: 849.99 },\n    { OrderItemID: 3, OrderID: 103, ProductID: 2, Quantity: 1, UnitPrice: 1199.99 },\n    { OrderItemID: 4, OrderID: 103, ProductID: 4, Quantity: 1, UnitPrice: 249.99 },\n    { OrderItemID: 5, OrderID: 104, ProductID: 4, Quantity: 1, UnitPrice: 249.99 },\n  ],\n  \'Payment Method\': [\n    { MethodID: 1, MethodName: \'Card\', Description: \'Credit / Debit Visa & MasterCard gateway\' },\n    { MethodID: 2, MethodName: \'COD\', Description: \'Cash On Delivery upon courier doorstep handover\' },\n    { MethodID: 3, MethodName: \'Wallet\', Description: \'JazzCash / Easypaisa / Raast digital wallet\' },\n  ],\n  \'Payment Status\': [\n    { StatusID: 1, StatusName: \'Pending\', Description: \'Awaiting bank clearance or COD handover\' },\n    { StatusID: 2, StatusName: \'Captured\', Description: \'Funds successfully settled into merchant ledger\' },\n    { StatusID: 3, StatusName: \'Failed\', Description: \'Transaction declined or gateway timeout\' },\n  ],\n  Payments: [\n    { PaymentID: 1, OrderID: 101, MethodID: 1, StatusID: 2, Amount: 1379.99, GatewayRef: \'GW-STRIPE-882193\', AuthCode: \'AUTH-99124\' },\n    { PaymentID: 2, OrderID: 102, MethodID: 2, StatusID: 1, Amount: 892.49, GatewayRef: \'COD-LEOPARD-5512\', AuthCode: \'COD-PEND\' },\n    { PaymentID: 3, OrderID: 103, MethodID: 1, StatusID: 2, Amount: 1542.48, GatewayRef: \'GW-VISA-991204\', AuthCode: \'AUTH-44102\' },\n    { PaymentID: 4, OrderID: 104, MethodID: 3, StatusID: 2, Amount: 272.49, GatewayRef: \'JAZZCASH-77123\', AuthCode: \'WALLET-8812\' },\n  ],\n  Carriers: [\n    { CarrierID: 1, CarrierName: \'Leopard\', ContactPhone: \'+92 21 111 300 786\' },\n    { CarrierID: 2, CarrierName: \'BlueEx\', ContactPhone: \'+92 21 111 258 339\' },\n    { CarrierID: 3, CarrierName: \'TCS\', ContactPhone: \'+92 21 111 123 456\' },\n  ],\n  \'Service Levels\': [\n    { ServiceLevelID: 1, LevelName: \'Standard\', EstDeliveryDays: 4 },\n    { ServiceLevelID: 2, LevelName: \'Express\', EstDeliveryDays: 1 },\n  ],\n  Shipments: [\n    { ShipmentID: 1, OrderID: 101, CarrierID: 1, ServiceLevelID: 2, TrackingNo: \'LEO-PK-98214512\', ShipDate: \'2024-11-16\', DeliveryDate: \'2024-11-17\' },\n    { ShipmentID: 2, OrderID: 102, CarrierID: 2, ServiceLevelID: 1, TrackingNo: \'BLU-EXP-1102948\', ShipDate: \'2024-11-17\', DeliveryDate: null },\n    { ShipmentID: 3, OrderID: 103, CarrierID: 3, ServiceLevelID: 2, TrackingNo: \'TCS-EXP-7712940\', ShipDate: \'2025-06-19\', DeliveryDate: \'2025-06-20\' },\n    { ShipmentID: 4, OrderID: 104, CarrierID: 1, ServiceLevelID: 1, TrackingNo: \'LEO-PK-33190284\', ShipDate: \'2025-07-23\', DeliveryDate: \'2025-07-26\' },\n  ],\n};\n\nexport const PRESET_SQL_QUERIES = [\n  {\n    title: \'Query 1: All Customers\',\n    sql: \'SELECT * FROM Customers;\',\n    description: \'Retrieves all registered customer records from the Customers table.\',\n  },\n  {\n    title: \'Query 2: High-Value Products (> $500)\',\n    sql: \'SELECT ProductName, Price FROM Product WHERE Price > 500;\',\n    description: \'Filters catalog products with retail selling price exceeding 500.\',\n  },\n  {\n    title: \'Query 3: Customer #1 Orders\',\n    sql: \'SELECT * FROM Orders WHERE CustomerID = 1;\',\n    description: \'Finds all orders placed by CustomerID 1 (Hira Raza).\',\n  },\n  {\n    title: \'Query 4: Product with Category (JOIN)\',\n    sql: \'SELECT ProductName, CategoryName FROM Product JOIN Category ON Product.CategoryID = Category.CategoryID;\',\n    description: \'Performs relational INNER JOIN connecting products to their normalized category classification.\',\n  },\n  {\n    title: \'Query 5: Captured Payments\',\n    sql: \'SELECT OrderID, Amount FROM Payments WHERE StatusID = 2;\',\n    description: \'Retrieves all successfully captured payment transactions (StatusID = 2).\',\n  },\n  {\n    title: \'Query 6: Order Financials Ledger (JOIN)\',\n    sql: \'SELECT OrderID, Subtotal, TotalAmount FROM OrderFinancials WHERE TotalAmount > 1000;\',\n    description: \'Audits orders generating revenue greater than $1,000 using the 1:1 financials table.\',\n  },\n  {\n    title: \'Query 7: Shipments with Carrier & Tracking (JOIN)\',\n    sql: \'SELECT TrackingNo, CarrierName, ShipDate FROM Shipments JOIN Carriers ON Shipments.CarrierID = Carriers.CarrierID;\',\n    description: \'Joins consignments with carrier names to demonstrate logistics foreign key resolution.\',\n  },\n];\n"
    }
