        }
        lines {
          text: "    id: \'base_customers\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    name: \'1. Customers (Base)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    domain: \'Customer\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    originalPurpose: \'Monolithic table originally housing customer credentials, multiple telephone numbers, alternate emails, and account status transitions.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    originalColumns: [\'CustomerID\', \'Name\', \'Phone1\', \'Phone2\', \'Email1\', \'Email2\', \'Status\', \'StatusChangedAt\'],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    anomalies: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Repeating groups of contact methods (Phone1, Phone2, Email1, Email2) violating 1NF.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Inability to record more than 2 numbers without schema alteration (DDL alteration penalty).\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Loss of status transition audit trail when overwriting Status field.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    nf1Explanation: \'Extracted contact methods into a dedicated `Customer Contact` entity, converting repeating columns into atomic rows linked by CustomerID.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    nf2Explanation: \'CustomerID was already a single-attribute key, hence no partial functional dependency existed.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    nf3Explanation: \'Separated mutable current status into `Customer Status` and historical audit logs into `Customer Status History`.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    resultingEntities: [\'Customers\', \'Customer Contact\', \'Customer Status\', \'Customer Status History\'],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: \'base_address\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    name: \'2. Address & Location (Base)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    domain: \'Address\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    originalPurpose: \'Combined physical street address, geographical GPS latitude/longitude, delivery zoning, and customer delivery preferences.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    originalColumns: [\'AddressID\', \'CustomerID\', \'Street\', \'City\', \'PostalCode\', \'Latitude\', \'Longitude\', \'Zone\', \'IsDefault\'],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    anomalies: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Spatial coordinate telemetry mixed with postal address details.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Redundant storage of identical addresses when multiple family members or office workers register.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    nf1Explanation: \'Decomposed composite geographic descriptors into atomic data types.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    nf2Explanation: \'Removed direct dependency on CustomerID to allow shared locations and multiple delivery locations.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    nf3Explanation: \'Split physical street/postal details into `Address`, spatial telemetry into `Location`, and resolved M:N relation via `Customer Address`.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    resultingEntities: [\'Address\', \'Location\', \'Customer Address\'],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
