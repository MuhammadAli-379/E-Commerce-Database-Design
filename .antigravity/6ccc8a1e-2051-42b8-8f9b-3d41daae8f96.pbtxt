                    {attr.name}\\n                      </span>\\n                    </div>\\n\\n                    <span className=\\\"text-[11px] text-slate-400 shrink-0\\\">\\n                      {attr.type}\\n                    </span>\\n                  </div>\\n                ))}\\n              </div>\\n\\n              {/* Footer Note */}\\n              <div className=\\\"px-4 py-2 bg-slate-950/60 border-t border-slate-800/80 text-[10px] text-slate-400 flex items-center justify-between\\\">\\n                <span>{entity.attributes.length} columns</span>\\n                <span className=\\\"font-mono text-cyan-400/90\\\">{entity.domain}</span>\\n              </div>\\n            </div>\\n          );\\n        })}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/components/RelationalSchema.tsx\", \"toolAction\":\"Creating RelationalSchema component\", \"toolSummary\":\"Build relational schema browser with SQL DDL generation and copy support\"}"
