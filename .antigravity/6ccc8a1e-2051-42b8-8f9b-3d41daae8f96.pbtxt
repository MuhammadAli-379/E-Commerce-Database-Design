        }
        lines {
          text: "          {visibleRelationships.map(rel => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const parentEntity = rawEntities.find("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              e => e.name.toLowerCase() === rel.parent.toLowerCase()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const childEntity = rawEntities.find("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              e => e.name.toLowerCase() === rel.child.toLowerCase()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            if (!parentEntity || !childEntity) return null;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const pPos = positions[parentEntity.id] || { x: parentEntity.x, y: parentEntity.y };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const cPos = positions[childEntity.id] || { x: childEntity.x, y: childEntity.y };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            // Card dimensions approximation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const cardWidth = 220;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const pHeight = 35 + parentEntity.attributes.length * 22;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const cHeight = 35 + childEntity.attributes.length * 22;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            // Connection anchor points"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const startX = pPos.x + cardWidth;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const startY = pPos.y + pHeight / 2;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const endX = cPos.x;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const endY = cPos.y + cHeight / 2;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            // Curved cubic bezier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const dx = Math.abs(endX - startX) * 0.5;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const pathData = `M ${startX} ${startY} C ${startX + dx} ${startY}, ${endX - dx} ${endY}, ${endX} ${endY}`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            // Determine highlighting"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const isConnectedToSelected ="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              selectedEntityId &&"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              (parentEntity.id === selectedEntityId || childEntity.id === selectedEntityId);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const isDimmed = selectedEntityId && !isConnectedToSelected;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            return ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <g"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                key={rel.id}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                className=\"pointer-events-auto cursor-pointer group\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                onClick={e => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  e.stopPropagation();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
