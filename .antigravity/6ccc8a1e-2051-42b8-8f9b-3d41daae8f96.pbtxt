'75600\' },\n  ],\n  Location: [\n    { LocationID: 1, AddressID: 1, Latitude: 33.6844, Longitude: 73.0479, Zone: \'North-Capital\' },\n    { LocationID: 2, AddressID: 2, Latitude: 31.5204, Longitude: 74.3587, Zone: \'Central-Punjab\' },\n    { LocationID: 3, AddressID: 3, Latitude: 24.8607, Longitude: 67.0011, Zone: \'South-Sindh\' },\n  ],\n  \'Customer Address\': [\n    { CustomerAddressID: 1, CustomerID: 1, LocationID: 1, IsDefault: true, AddressType: \'Shipping\' },\n    { CustomerAddressID: 2, CustomerID: 2, LocationID: 2, IsDefault: true, AddressType: \'Shipping\' },\n    { CustomerAddressID: 3, CustomerID: 3, LocationID: 3, IsDefault: true, AddressType: \'Shipping\' },\n  ],\n  Category: [\n    { CategoryID: 1, CategoryName: \'Smartphones\', Description: \'Flagship & budget mobile computing handsets\' },\n    { CategoryID: 2, CategoryName: \'Laptops\', Description: \'Portable computing and workstations\' },\n    { CategoryID: 3, CategoryName: \'Accessories\', Description: \'Peripherals, power adapters, and audio\' },\n  ],\n  Brand: [\n    { BrandID: 1, BrandName: \'Samsung\', Country: \'South Korea\' },\n    { BrandID: 2, BrandName: \'Apple\', Country: \'United States\' },\n    { BrandID: 3, BrandName: \'HP\', Country: \'United States\' },\n  ],\n  Product: [\n    { ProductID: 1, CategoryID: 1, BrandID: 1, SKU: \'SAM-S24U-512\', ProductName: \'Samsung S24 Ultra\', Price: 1299.99, Cost: 950.00, Active: true },\n    { ProductID: 2, CategoryID: 1, BrandID: 2, SKU: \'APL-IP15PM-256\', ProductName: \'iPhone 15 Pro Max\', Price: 1199.99, Cost: 890.00, Active: true },\n    { ProductID: 3, CategoryID: 2, BrandID: 3, SKU: \'HP-VIC15-I7\', ProductName: \'HP Victus 15\', Price: 849.99, Cost: 620.00, Active: true },\n    { ProductID: 4, CategoryID: 3, BrandID: 2, SKU: \'APL-AIRPODS-PRO2\', ProductName: \'AirPods Pro 2\', Price: 249.99, Cost: 160.00, Active: true },\n    { ProductID: 5, CategoryID: 3, BrandID: 1, SKU: \'SAM-GW6-44\', ProductName: \'Samsung Galaxy Watch 