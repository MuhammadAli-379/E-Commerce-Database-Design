    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport {\n  LayoutDashboard,\n  Network,\n  TableProperties,\n  GitFork,\n  SlidersHorizontal,\n  Code2,\n  Database,\n  Terminal,\n  FileText,\n  ChevronRight,\n  GraduationCap,\n  Sparkles,\n  ShieldCheck,\n} from \'lucide-react\';\n\ninterface SidebarProps {\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  mobileMenuOpen: boolean;\n  setMobileMenuOpen: (open: boolean) => void;\n  schemaCountMode: 19 | 21;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  activeTab,\n  setActiveTab,\n  mobileMenuOpen,\n  setMobileMenuOpen,\n  schemaCountMode,\n}) => {\n  const navItems = [\n    { id: \'overview\', label: \'1. Overview\', icon: LayoutDashboard, badge: \'Dashboard\' },\n    { id: \'erd\', label: \'2. ERD Explorer\', icon: Network, badge: \'Interactive\' },\n    { id: \'entities\', label: \'3. Entities Catalog\', icon: TableProperties, count: schemaCountMode },\n    { id: \'relationships\', label: \'4. Relationships\', icon: GitFork, count: \'16+\' },\n    { id: \'normalization\', label: \'5. Normalization Lab\', icon: SlidersHorizontal, badge: \'1NF-3NF\' },\n    { id: \'schema\', label: \'6. Relational Schema\', icon: Code2, badge: \'DDL\' },\n    { id: \'data\', label: \'7. Data Explorer\', icon: Database, badge: \'Live Rows\' },\n    { id: \'sql\', label: \'8. SQL Playground\', icon: Terminal, badge: \'Query Engine\' },\n    { id: \'report\', label: \'9. Project Report\', icon: FileText, badge: \'Academic\' },\n  ];\n\n  const handleSelect = (id: string) => {\n    setActiveTab(id);\n    setMobileMenuOpen(false);\n  };\n\n  return (\n    <>\n      {/* Mobile Backdrop */}\n      {mobileMenuOpen && (\n        <div\n          onClick={() => setMobileMenuOpen(false)}\n          className=\"fixed inset-0 z-40 bg-slate-950/80 backdrop-blur-sm lg:hidden\"\n        />\n      )}\n\n      {/* Main Sidebar */}\n      <aside\n        className={`fixed lg:sticky top-0 lg:top-[57px] left-0 z-50 lg:z-20 w-64 lg:w-64 h-full lg:h-[calc(100vh-57px)] bg-slate-950 border-r border-slate-800 flex flex-col justify-between transition-transform duration-200 ease-out ${\n          mobileMenuOpen ? \'translate-x-0\' : \'-translate-x-full lg:translate-x-0\'\n        }`}\n      >\n        {/* Top Section */}\n        <div className=\"p-4 flex flex-col flex-1 overflow-y-auto\">\n          {/* Mobile Header Branding */}\n          <div className=\"flex items-center justify-between pb-4 mb-3 border-b border-slate-800 lg:hidden\">\n            <div className=\"flex items-center gap-2\">\n              <Database className=\"w-5 h-5 text-cyan-400\" />\n              <span className=\"font-semibold text-sm text-white\">Database Systems</span>\n            </div>\n            <button\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"p-1 rounded text-slate-400 hover:text-white\"\n            >\n              \342\234\225\n            </button>\n          </div>\n\n          <div className=\"px-2 py-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1\">\n            System Modules\n          </div>\n\n          {/* Navigation Links */}\n          <nav className=\"space-y-1\">\n            {navItems.map(item => {\n              const Icon = item.icon;\n              const isActive = activeTab === item.id;\n              return (\n                <button\n                  key={item.id}\n                  onClick={() => handleSelect(item.id)}\n                  className={`w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium transition-all group ${\n                    isActive\n                      ? \'bg-slate-900 text-cyan-400 border border-slate-800 shadow-sm\'\n                      : \'text-slate-400 hover:text-slate-200 hover:bg-slate-900/50\'\n                  }`}\n                >\n                  <div className=\"flex items-center gap-2.5\">\n                    <Icon\n                      className={`w-4 h-4 transition-colors ${\n                        isActive ? \'text-cyan-400\' : \'text-slate-500 group-hover:text-slate-300\'\n                      }`}\n                    />\n                    <span className=\"truncate\">{item.label}</span>\n                  </div>\n\n                  <div className=\"flex items-center gap-1.5\">\n                    {item.badge && (\n                      <span\n                        className={`text-[10px] px-1.5 py-0.5 rounded font-mono ${\n                          isActive\n                            ? \'bg-cyan-500/10 text-cyan-300\'\n                            : \'bg-slate-800/80 text-slate-400\'\n                        }`}\n                      >\n                        {item.badge}\n                      </span>\n                    )}\n                    {item.count && (\n                      <span className=\"text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-800 text-slate-400\">\n                        {item.count}\n                      </span>\n                    )}\n                    <ChevronRight\n                      className={`w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity ${\n                        isActive ? \'opacity-100 text-cyan-400\' : \'text-slate-600\'\n                      }`}\n                    />\n                  </div>\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* Quick Transformation Metric Pill */}\n          <div className=\"mt-6 p-3 rounded-lg bg-gradient-to-br from-slate-900 to-slate-900/40 border border-slate-800/90 text-xs\">\n            <div className=\"flex items-center justify-between text-slate-400 mb-1.5\">\n              <span className=\"font-semibold text-white flex items-center gap-1\">\n                <Sparkles className=\"w-3.5 h-3.5 text-cyan-400\" /> Relational Architecture\n              </span>\n            </div>\n            <div className=\"text-[11px] text-slate-400 leading-relaxed\">\n              <span className=\"text-amber-400 font-mono font-medium\">9 Base Tables</span>\n              <span className=\"text-slate-500 mx-1.5\">\342\206\222</span>\n              <span className=\"text-cyan-300 font-mono font-medium\">{schemaCountMode} Normalized</span>\n            </div>\n            <div className=\"mt-2 pt-2 border-t border-slate-800 flex items-center justify-between text-[10px] text-slate-400\">\n              <span>BCNF / 3NF Verified</span>\n              <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n            </div>\n          </div>\n        </div>\n\n        {/* Bottom Student Academic Attribution */}\n        <div className=\"p-4 border-t border-slate-800/80 bg-slate-950/80\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-full bg-slate-900 border border-slate-700 flex items-center justify-center shrink-0\">\n              <GraduationCap className=\"w-4 h-4 text-cyan-400\" />\n            </div>\n            <div className=\"min-w-0\">\n              <div className=\"text-xs font-semibold text-white truncate\">\n                Muhammad Abu Bakar\n              </div>\n              <div className=\"text-[11px] text-slate-400 truncate\">\n                FA24-BBD-109\n              </div>\n              <div className=\"text-[10px] text-cyan-400/90 truncate mt-0.5\">\n                Instructor: Sir Ayyaz Mahmood\n              </div>\n            </div>\n          </div>\n        </div>\n      </aside>\n    </>\n  );\n};\n"
    }
